# Copia este archivo a .env y rellena los valores.

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# ─── Panel /admin ────────────────────────────────────────────────────────────
# Contraseña para entrar en /admin.
ADMIN_PASSWORD="elige-una-contrasena"
# Secreto para firmar la cookie de sesión. Genera uno con: openssl rand -base64 36
AUTH_SECRET="genera-un-valor-aleatorio-largo"

# ─── Autocompletado por ISBN/título (opcional) ───────────────────────────────
# Clave GRATUITA de Google Books. Si la pones, el autocompletado usa tu cuota
# propia (~1.000/día) en vez de la compartida, que se agota (error 429).
# Se crea en https://console.cloud.google.com → API "Books API" → Credenciales.
# Si se deja vacía, todo funciona igual con la cuota compartida.
GOOGLE_BOOKS_API_KEY=""
