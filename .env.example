# Copia este archivo a .env y rellena los valores.

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# ─── Panel /admin ────────────────────────────────────────────────────────────
# Contraseña para entrar en /admin.
ADMIN_PASSWORD="elige-una-contrasena"
# Secreto para firmar la cookie de sesión. Genera uno con: openssl rand -base64 36
AUTH_SECRET="genera-un-valor-aleatorio-largo"

# ─── Autocompletado por ISBN/título (opcional) ───────────────────────────────
# Clave GRATUITA de Google Books. Si la pones, el autocompletado usa tu cuota
# propia (~1.000/día) en vez de la compartida, que se agota (error 429).
# Se crea en https://console.cloud.google.com → API "Books API" → Credenciales.
# Si se deja vacía, todo funciona igual con la cuota compartida.
GOOGLE_BOOKS_API_KEY=""

# ─── Sinopsis con IA (opcional) ──────────────────────────────────────────────
# Clave de la API de Claude (Anthropic) para el botón "Redactar con IA" y la
# página /admin/sinopsis. Se crea en https://console.anthropic.com (Settings →
# API keys; requiere cargar un pequeño saldo, ~5 €, que dura muchísimo: cada
# sinopsis cuesta ~0,6 céntimos). Si se deja vacía, la web funciona igual.
ANTHROPIC_API_KEY=""

# ─── Copia de seguridad automática (opcional) ────────────────────────────────
# Secreto que autoriza el cron semanal de Vercel a llamar a /api/copia-seguridad
# (guarda un CSV de la colección en Supabase y limpia portadas huérfanas).
# Genera uno con: openssl rand -hex 24 — y ponlo IGUAL en Vercel y aquí.
# Si se deja vacío, no hay copia automática (la manual del botón sigue igual).
CRON_SECRET=""
