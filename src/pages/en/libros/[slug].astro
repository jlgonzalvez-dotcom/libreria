---
// Ficha de libro en inglés (/en/libros/…): mismas URLs que en español con el
// prefijo del idioma, para que el botón ES/EN sea un simple cambio de prefijo.
import FichaLibro from '../../../components/FichaLibro.astro';
import { listarLibros } from '../../../lib/libros';

const { slug } = Astro.params;

const todos = await listarLibros();
const libro = todos.find((l) => l.slug === slug) ?? null;

if (!libro) {
  return Astro.rewrite('/en/404');
}
---

<FichaLibro lang="en" libro={libro} todos={todos} />
