---
// 404 general: la sirve Astro para cualquier URL desconocida, así que el idioma
// se deduce de la propia dirección (/en/loquesea → inglés).
import PaginaError from '../components/PaginaError.astro';
import { idiomaDe } from '../lib/i18n';

Astro.response.status = 404;
---

<PaginaError lang={idiomaDe(Astro.url)} codigo="404" />
