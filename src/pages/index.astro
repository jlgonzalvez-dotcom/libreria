---
import Layout from '../layouts/Layout.astro';
import { listarLibros } from '../lib/libros';

// SSR: se lee de la base de datos en cada petición.
const libros = await listarLibros();

// Lista de categorías para los filtros.
const categorias = [...new Set(libros.map((l) => l.categoria))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);

const total = libros.length;
const leidos = libros.filter((l) => l.estado === 'leído').length;

// Renderiza estrellas como texto (★ llenas / ☆ vacías).
function estrellas(n?: number | null) {
  if (n == null) return null;
  const llenas = '★'.repeat(Math.round(n));
  const vacias = '☆'.repeat(5 - Math.round(n));
  return { llenas, vacias };
}
---

<Layout titulo="Mi Librería — Catálogo" descripcion="Catálogo de mi biblioteca personal, clasificado por categorías.">
  <section class="hero">
    <div class="contenedor">
      <h1>Mi biblioteca personal</h1>
      <p>Todos mis libros, bien clasificados y a un clic. Busca por título o autor, o filtra por categoría.</p>
      <div class="stats">
        <div class="stat"><strong>{total}</strong><span>Libros</span></div>
        <div class="stat"><strong>{categorias.length}</strong><span>Categorías</span></div>
        <div class="stat"><strong>{leidos}</strong><span>Leídos</span></div>
      </div>
    </div>
  </section>

  <section class="controles">
    <div class="contenedor">
      <input
        id="buscador"
        class="buscador"
        type="search"
        placeholder="Buscar por título, autor o etiqueta…"
        autocomplete="off"
      />
      <div class="chips" id="chips">
        <button class="chip activo" data-cat="*">Todas</button>
        {categorias.map((c) => <button class="chip" data-cat={c}>{c}</button>)}
      </div>
      <p class="contador" id="contador">{total} libros</p>
    </div>
  </section>

  <section class="contenedor">
    {
      total === 0 ? (
        <p class="vacio">Aún no hay libros en el catálogo. Añade el primero desde el <a href="/admin">panel de administración</a>.</p>
      ) : (
        <div class="rejilla" id="rejilla">
          {libros.map((libro) => {
            const est = estrellas(libro.valoracion);
            const busqueda = `${libro.titulo} ${libro.autor} ${libro.subcategorias.join(' ')} ${libro.etiquetas.join(' ')}`.toLowerCase();
            return (
              <article class="libro" data-categoria={libro.categoria} data-busqueda={busqueda}>
                <a href={`/libros/${libro.slug}/`}>
                  <div class="portada">
                    {libro.portada ? <img src={libro.portada} alt={`Portada de ${libro.titulo}`} /> : libro.titulo.charAt(0)}
                  </div>
                  <div class="cuerpo">
                    <div class="titulo">{libro.titulo}</div>
                    <div class="autor">{libro.autor}</div>
                    <div class="meta">
                      <span class="badge cat">{libro.categoria}</span>
                      {est && (
                        <span class="estrellas">
                          {est.llenas}<span class="vacia">{est.vacias}</span>
                        </span>
                      )}
                    </div>
                    <div class="meta">
                      <span class={`estado ${libro.estado}`}>{libro.estado}</span>
                      {libro.anio && <span class="badge">{libro.anio}</span>}
                    </div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      )
    }
  </section>
</Layout>

<script>
  const buscador = document.getElementById('buscador') as HTMLInputElement | null;
  const chips = document.getElementById('chips');
  const contador = document.getElementById('contador');
  const tarjetas = Array.from(document.querySelectorAll<HTMLElement>('.libro'));

  let categoria = '*';
  let texto = '';

  function aplicar() {
    if (!contador) return;
    let visibles = 0;
    for (const t of tarjetas) {
      const okCat = categoria === '*' || t.dataset.categoria === categoria;
      const okTxt = texto === '' || (t.dataset.busqueda ?? '').includes(texto);
      const mostrar = okCat && okTxt;
      t.style.display = mostrar ? '' : 'none';
      if (mostrar) visibles++;
    }
    contador.textContent = `${visibles} ${visibles === 1 ? 'libro' : 'libros'}`;
  }

  chips?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.chip') as HTMLElement | null;
    if (!btn) return;
    chips.querySelectorAll('.chip').forEach((c) => c.classList.remove('activo'));
    btn.classList.add('activo');
    categoria = btn.dataset.cat ?? '*';
    aplicar();
  });

  buscador?.addEventListener('input', () => {
    texto = buscador.value.trim().toLowerCase();
    aplicar();
  });
</script>
