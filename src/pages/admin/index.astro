---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listarLibros } from '../../lib/libros';
import { supabase } from '../../lib/supabase';

const libros = await listarLibros();
const total = libros.length;

// ── Resumen de un vistazo (pedido por JLG: "estadísticas automatizadas") ─────
// Visitas de los últimos 7 días (personas distintas + páginas vistas).
const hace7 = new Date(Date.now() - 6 * 86400000).toISOString().slice(0, 10);
const { data: vis } = await supabase
  .from('visitas')
  .select('visitante')
  .gte('dia', hace7)
  .limit(20000);
const vistas7 = (vis ?? []).length;
const personas7 = new Set((vis ?? []).map((v) => v.visitante)).size;

// Pulso de la colección.
const hace30 = Date.now() - 30 * 86400000;
const nuevosMes = libros.filter((l) => new Date(l.created_at).getTime() >= hace30).length;
const borradoresPendientes = libros.filter((l) => l.sinopsis_borrador && l.sinopsis_borrador.trim() !== '').length;
const sinUbicacion = libros.filter((l) => !l.ubicacion || l.ubicacion.trim() === '').length;

// Posible mensaje de confirmación tras guardar/borrar (?ok=creado|editado|borrado).
const ok = Astro.url.searchParams.get('ok');
const mensajes: Record<string, string> = {
  creado: 'Libro añadido correctamente.',
  editado: 'Cambios guardados.',
  borrado: 'Libro eliminado.',
};
const aviso = ok ? mensajes[ok] : '';
---

<AdminLayout titulo="Biblioteca · Admin">
  <section class="contenedor admin">
    <div class="admin-top">
      <div>
        <h1>Tu biblioteca</h1>
        <p class="admin-sub">{total} {total === 1 ? 'libro' : 'libros'} en el catálogo.</p>
      </div>
      <div class="admin-acciones">
        <a href="/admin/rafaga" class="btn-secundario">⚡ Modo ráfaga</a>
        <a href="/admin/nuevo" class="btn">+ Añadir libro</a>
      </div>
    </div>

    {aviso && <p class="aviso ok">{aviso}</p>}

    <div class="vis-cifras resumen">
      <a class="vis-cifra" href="/admin/visitas">
        <strong>{personas7}</strong>
        <span>{personas7 === 1 ? 'persona' : 'personas'} esta semana ({vistas7} vistas)</span>
      </a>
      <div class="vis-cifra">
        <strong>{total}</strong>
        <span>libros{nuevosMes > 0 ? ` · +${nuevosMes} este mes` : ''}</span>
      </div>
      <a class="vis-cifra" href="/admin/sinopsis">
        <strong>{borradoresPendientes}</strong>
        <span>{borradoresPendientes === 1 ? 'sinopsis por revisar' : 'sinopsis por revisar'}</span>
      </a>
      <a class="vis-cifra" href="/admin/ubicaciones">
        <strong>{sinUbicacion}</strong>
        <span>sin ubicación</span>
      </a>
    </div>

    {
      total === 0 ? (
        <p class="vacio">Todavía no hay libros. <a href="/admin/nuevo">Añade el primero</a>.</p>
      ) : (
        <>
        <div class="admin-buscar" style="margin: 4px 0 20px">
          <input id="admin-buscador" class="buscador" type="search" placeholder="Buscar por título, autor, categoría o ubicación…" autocomplete="off" />
        </div>
        <table class="tabla">
          <thead>
            <tr>
              <th>Título</th>
              <th>Autor</th>
              <th>Categoría</th>
              <th>Ubicación</th>
              <th>Estado</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {libros.map((libro) => (
              <tr data-busqueda={`${libro.titulo} ${libro.autor} ${libro.categoria} ${libro.ubicacion ?? ''}`.toLowerCase()}>
                <td>
                  <a href={`/admin/${libro.id}`} class="td-titulo">{libro.titulo}</a>
                  {libro.destacado && <span class="badge dest">★ destacado</span>}
                  {libro.ejemplares > 1 && <span class="badge">×{libro.ejemplares} ejemplares</span>}
                </td>
                <td>{libro.autor}</td>
                <td><span class="badge cat">{libro.categoria}</span></td>
                <td class="td-ubicacion">{libro.ubicacion || <span class="ayuda">—</span>}</td>
                <td><span class={`estado ${libro.estado}`}>{libro.estado}</span></td>
                <td class="acciones">
                  <a href={`/admin/${libro.id}`} class="link-accion">Editar</a>
                  <a href={`/libros/${libro.slug}/`} target="_blank" class="link-accion">Ver</a>
                  <form
                    method="POST"
                    action="/admin/borrar"
                    onsubmit="return confirm('¿Eliminar este libro? Esta acción no se puede deshacer.')"
                    class="form-inline"
                  >
                    <input type="hidden" name="id" value={libro.id} />
                    <button type="submit" class="link-accion borrar">Borrar</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        </>
      )
    }
  </section>
</AdminLayout>

<script>
  const buscador = document.getElementById('admin-buscador') as HTMLInputElement | null;
  const filas = Array.from(document.querySelectorAll<HTMLElement>('tbody tr'));
  const sub = document.querySelector('.admin-sub');
  const totalLibros = filas.length;
  const plural = (n: number) => `${n} ${n === 1 ? 'libro' : 'libros'}`;
  buscador?.addEventListener('input', () => {
    const q = buscador.value.trim().toLowerCase();
    let visibles = 0;
    for (const tr of filas) {
      const ok = q === '' || (tr.dataset.busqueda ?? '').includes(q);
      tr.style.display = ok ? '' : 'none';
      if (ok) visibles++;
    }
    if (sub) sub.textContent = q === ''
      ? `${plural(totalLibros)} en el catálogo.`
      : `${visibles} de ${plural(totalLibros)}.`;
  });
</script>
