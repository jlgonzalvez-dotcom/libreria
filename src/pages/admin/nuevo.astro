---
import AdminLayout from '../../layouts/AdminLayout.astro';
import FormularioLibro from '../../components/FormularioLibro.astro';
import { listarLibros } from '../../lib/libros';

const libros = await listarLibros();
const categoriasExistentes = [...new Set(libros.map((l) => l.categoria))];
---

<AdminLayout titulo="Nuevo libro · Admin">
  <section class="contenedor admin-form">
    <a href="/admin" class="volver">← Volver al listado</a>
    <h1>Añadir libro</h1>
    <FormularioLibro categoriasExistentes={categoriasExistentes} />
  </section>
</AdminLayout>
