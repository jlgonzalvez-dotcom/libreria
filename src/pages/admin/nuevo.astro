---
import AdminLayout from '../../layouts/AdminLayout.astro';
import FormularioLibro from '../../components/FormularioLibro.astro';
import { listarLibros, sugerenciasDesde } from '../../lib/libros';

const sugerencias = sugerenciasDesde(await listarLibros());
---

<AdminLayout titulo="Nuevo libro · Admin">
  <section class="contenedor admin-form">
    <a href="/admin" class="volver">← Volver al listado</a>
    <h1>Añadir libro</h1>
    <FormularioLibro sugerencias={sugerencias} />
  </section>
</AdminLayout>
