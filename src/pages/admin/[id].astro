---
import AdminLayout from '../../layouts/AdminLayout.astro';
import FormularioLibro from '../../components/FormularioLibro.astro';
import { listarLibros, obtenerLibroPorId, sugerenciasDesde } from '../../lib/libros';

const { id } = Astro.params;
const libro = id ? await obtenerLibroPorId(id) : null;

if (!libro) {
  return Astro.redirect('/admin');
}

const sugerencias = sugerenciasDesde(await listarLibros());
---

<AdminLayout titulo={`Editar · ${libro.titulo}`}>
  <section class="contenedor admin-form">
    <a href="/admin" class="volver">← Volver al listado</a>
    <h1>Editar libro</h1>
    <FormularioLibro libro={libro} sugerencias={sugerencias} />
  </section>
</AdminLayout>
