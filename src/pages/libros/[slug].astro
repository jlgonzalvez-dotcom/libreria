---
import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import { obtenerLibroPorSlug } from '../../lib/libros';

const { slug } = Astro.params;
const libro = slug ? await obtenerLibroPorSlug(slug) : null;

if (!libro) {
  return new Response('Libro no encontrado', { status: 404 });
}

function estrellas(n?: number | null) {
  if (n == null) return null;
  return '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));
}
const autores = [libro.autor, ...libro.autores_extra].join(', ');

// Las notas se escriben en Markdown desde el panel /admin (contenido propio).
const notasHtml = libro.notas ? marked.parse(libro.notas) : '';
---

<Layout titulo={`${libro.titulo} — Mi Librería`} descripcion={libro.sinopsis ?? libro.titulo}>
  <section class="detalle">
    <div class="contenedor">
      <a class="volver" href="/">← Volver al catálogo</a>

      <div class="grid">
        <div class="portada-grande">
          {libro.portada ? <img src={libro.portada} alt={`Portada de ${libro.titulo}`} /> : libro.titulo.charAt(0)}
        </div>

        <div>
          <span class="badge cat">{libro.categoria}</span>
          <h1>{libro.titulo}</h1>
          <p class="autor-grande">{autores}</p>
          {libro.sinopsis && <p>{libro.sinopsis}</p>}

          <div class="ficha">
            <dl>
              {libro.anio && (<><dt>Año</dt><dd>{libro.anio}</dd></>)}
              {libro.editorial && (<><dt>Editorial</dt><dd>{libro.editorial}</dd></>)}
              {libro.paginas && (<><dt>Páginas</dt><dd>{libro.paginas}</dd></>)}
              <dt>Idioma</dt><dd>{libro.idioma}</dd>
              <dt>Formato</dt><dd>{libro.formato}</dd>
              <dt>Estado</dt><dd><span class={`estado ${libro.estado}`}>{libro.estado}</span></dd>
              {libro.valoracion != null && (<><dt>Valoración</dt><dd><span class="estrellas">{estrellas(libro.valoracion)}</span></dd></>)}
              {libro.isbn && (<><dt>ISBN</dt><dd>{libro.isbn}</dd></>)}
              {libro.ubicacion && (<><dt>Ubicación</dt><dd>{libro.ubicacion}</dd></>)}
              {libro.subcategorias.length > 0 && (
                <><dt>Géneros</dt><dd>{libro.subcategorias.join(', ')}</dd></>
              )}
              {libro.etiquetas.length > 0 && (
                <><dt>Etiquetas</dt>
                <dd><div class="tags">{libro.etiquetas.map((t) => <span class="badge">{t}</span>)}</div></dd></>
              )}
              {libro.en_venta && (
                <><dt>En venta</dt>
                <dd>{libro.precio != null ? `${libro.precio} €` : 'Sí'}{libro.estado_conservacion ? ` · ${libro.estado_conservacion}` : ''}</dd></>
              )}
            </dl>
          </div>

          {notasHtml && <div class="cuerpo-md" set:html={notasHtml} />}
        </div>
      </div>
    </div>
  </section>
</Layout>
