---
import FichaLibro from '../../components/FichaLibro.astro';
import { listarLibrosPublicos } from '../../lib/libros';

const { slug } = Astro.params;

// Una sola consulta: el libro por su slug + el resto para "relacionados".
const todos = await listarLibrosPublicos();
const libro = todos.find((l) => l.slug === slug) ?? null;

if (!libro) {
  // Página 404 con el estilo de la casa (en vez de un texto plano).
  return Astro.rewrite('/404');
}
---

<FichaLibro lang="es" libro={libro} todos={todos} />
