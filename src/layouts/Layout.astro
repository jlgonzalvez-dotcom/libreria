---
import '../styles/global.css';
import { idiomaDe, rutaEnIdioma, ruta, textos, LOCALE, type Idioma } from '../lib/i18n';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** URL de la imagen para la vista previa al compartir (portada del libro). */
  imagen?: string | null;
  /** Tipo Open Graph: 'website' (por defecto) o 'book' en las fichas. */
  tipo?: 'website' | 'book';
  /** Idioma de la página. Por defecto, el que indica la URL (/en/… → inglés). */
  lang?: Idioma;
  /** Texto alternativo de la imagen para compartir. */
  imagenAlt?: string;
}

const {
  imagen = null,
  tipo = 'website',
  lang = idiomaDe(Astro.url),
} = Astro.props;

const t = textos(lang);
const titulo = Astro.props.titulo ?? t('titulo_inicio');
const descripcion = Astro.props.descripcion ?? t('descripcion_inicio');

// URLs absolutas para compartir (WhatsApp, etc. exigen URL completa, no relativa).
const canonica = new URL(Astro.url.pathname, Astro.site).href;
// La misma página en cada idioma, para las etiquetas hreflang: así Google sabe
// que son dos versiones de lo mismo y ofrece la inglesa a quien busca en inglés.
const urlEs = new URL(rutaEnIdioma(Astro.url, 'es'), Astro.site).href;
const urlEn = new URL(rutaEnIdioma(Astro.url, 'en'), Astro.site).href;
const otroIdioma: Idioma = lang === 'es' ? 'en' : 'es';
// Selector ES/EN: siempre en el mismo orden, con el idioma actual resaltado y
// el otro como enlace a la misma página traducida.
const opcionesIdioma = (['es', 'en'] as const).map((codigo) => ({
  codigo,
  rotulo: codigo.toUpperCase(),
  actual: codigo === lang,
  href: rutaEnIdioma(Astro.url, codigo),
}));

// Si la página no aporta imagen (p. ej. la portada del libro), se usa el
// cartel genérico de la web. La portada de un libro es vertical → tarjeta
// pequeña ("summary"); el cartel es apaisado → tarjeta grande.
const imagenOg = new URL(imagen ?? '/og-portada.png', Astro.site).href;
const tarjetaTwitter = imagen ? 'summary' : 'summary_large_image';
// Texto alternativo de la vista previa: la portada del libro lleva su propio
// alt desde la ficha; el cartel genérico describe la web.
const imagenAlt = Astro.props.imagenAlt ?? (imagen ? titulo : 'La librería de JL');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <link rel="canonical" href={canonica} />

    <!-- Las dos versiones de idioma (la española es la de referencia). -->
    <link rel="alternate" hreflang="es" href={urlEs} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlEs} />

    <!-- Vista previa al compartir (WhatsApp, Telegram, redes…) -->
    <meta property="og:site_name" content="La librería de JL" />
    <meta property="og:locale" content={LOCALE[lang]} />
    <meta property="og:locale:alternate" content={LOCALE[otroIdioma]} />
    <meta property="og:type" content={tipo} />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:alt" content={imagenAlt} />
    {!imagen && (<><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>)}
    <meta name="twitter:card" content={tarjetaTwitter} />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOg} />

    <!-- Color de la barra del navegador (móvil); lo actualiza el modo noche. -->
    <meta name="theme-color" content="#faf7f1" id="meta-tema" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ctext y='14' font-size='14'%3E%F0%9F%93%9A%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Aplica el tema guardado ANTES de pintar, para que no parpadee.
      (function () {
        try {
          if (localStorage.getItem('tema') === 'noche') {
            document.documentElement.setAttribute('data-tema', 'noche');
            document.getElementById('meta-tema')?.setAttribute('content', '#16120e');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="saltar-contenido" href="#contenido">{t('saltar_contenido')}</a>
    <header class="site-header">
      <div class="contenedor">
        <a href={ruta(lang, '/')} class="logo">La librería de <span>JL</span></a>
        <nav class="nav nav-publica">
          <a href={ruta(lang, '/')}>{t('nav_catalogo')}</a>
          <div class="idioma-sel" role="group" aria-label={t('nav_idioma_aria')}>
            {opcionesIdioma.map((op) => op.actual ? (
              <span class="idioma-op activo" aria-current="true">{op.rotulo}</span>
            ) : (
              <a class="idioma-op" href={op.href} hreflang={op.codigo} title={t('nav_idioma_title')}>{op.rotulo}</a>
            ))}
          </div>
          <button
            id="tema-toggle"
            class="tema-btn"
            type="button"
            aria-pressed="false"
            aria-label={t('tema_a_noche')}
            title={t('nav_tema_title')}
            data-a-noche={t('tema_a_noche')}
            data-a-dia={t('tema_a_dia')}
          >🌙</button>
        </nav>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="contenedor">
        {t('pie')}
      </div>
    </footer>
    <script>
      // Toggle día/noche. El tema inicial ya lo aplicó el script del <head>;
      // aquí solo ajustamos el icono y manejamos el clic.
      (function () {
        const btn = document.getElementById('tema-toggle');
        let actual = document.documentElement.getAttribute('data-tema') === 'noche' ? 'noche' : 'dia';
        // El botón dice a qué modo lleva (no en cuál estás) y expone su estado
        // con aria-pressed, para que un lector de pantalla lo anuncie bien.
        const pintar = () => {
          if (!btn) return;
          const noche = actual === 'noche';
          btn.textContent = noche ? '☀️' : '🌙';
          btn.setAttribute('aria-pressed', String(noche));
          const etiqueta = noche ? btn.dataset.aDia : btn.dataset.aNoche;
          if (etiqueta) btn.setAttribute('aria-label', etiqueta);
        };
        pintar();
        btn?.addEventListener('click', () => {
          actual = actual === 'noche' ? 'dia' : 'noche';
          document.documentElement.setAttribute('data-tema', actual);
          document.getElementById('meta-tema')?.setAttribute('content', actual === 'noche' ? '#16120e' : '#faf7f1');
          try { localStorage.setItem('tema', actual); } catch (e) {}
          pintar();
        });
      })();
    </script>
  </body>
</html>
