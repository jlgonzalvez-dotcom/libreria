---
import type { Libro } from '../lib/libros';
import {
  ESTADOS,
  FORMATOS,
  ESTADOS_CONSERVACION,
  CATEGORIAS_SUGERIDAS,
  IDIOMAS,
} from '../lib/libros';

interface Props {
  libro?: Libro | null;
  categoriasExistentes?: string[];
  error?: string;
}

const { libro = null, categoriasExistentes = [], error = '' } = Astro.props;

// Valores actuales (vacíos al crear).
const v = {
  titulo: libro?.titulo ?? '',
  autor: libro?.autor ?? '',
  autores_extra: (libro?.autores_extra ?? []).join(', '),
  categoria: libro?.categoria ?? '',
  subcategorias: (libro?.subcategorias ?? []).join(', '),
  etiquetas: (libro?.etiquetas ?? []).join(', '),
  anio: libro?.anio ?? '',
  idioma: libro?.idioma ?? 'Español',
  editorial: libro?.editorial ?? '',
  isbn: libro?.isbn ?? '',
  paginas: libro?.paginas ?? '',
  estado: libro?.estado ?? 'pendiente',
  valoracion: libro?.valoracion ?? '',
  ubicacion: libro?.ubicacion ?? '',
  formato: libro?.formato ?? 'papel',
  portada: libro?.portada ?? '',
  sinopsis: libro?.sinopsis ?? '',
  notas: libro?.notas ?? '',
  destacado: libro?.destacado ?? false,
  en_venta: libro?.en_venta ?? false,
  precio: libro?.precio ?? '',
  estado_conservacion: libro?.estado_conservacion ?? '',
  resena: libro?.resena ?? '',
};

const categorias = [...new Set([...CATEGORIAS_SUGERIDAS, ...categoriasExistentes])]
  .filter((c) => c && c.trim() !== '')
  .sort((a, b) => a.localeCompare(b, 'es'));

// ¿La categoría guardada NO está entre las opciones? Entonces es "personalizada"
// y arrancamos mostrando el campo de texto libre (opción "Otra…").
const categoriaPersonalizada = v.categoria !== '' && !categorias.includes(v.categoria);
---

<form method="POST" action="/admin/guardar" class="form-libro">
  {libro && <input type="hidden" name="id" value={libro.id} />}
  {error && <p class="aviso error">{error}</p>}

  <fieldset>
    <legend>Identidad</legend>

    <div class="campo autocompletar">
      <label for="isbn">ISBN o título (autocompletar)</label>
      <div class="autocompletar-fila">
        <input id="isbn" name="isbn" type="text" value={v.isbn} placeholder="978… o título del libro" />
        <button type="button" id="btn-autocompletar" class="btn-secundario">Buscar datos</button>
        <button type="button" id="btn-escanear" class="btn-secundario" title="Escanear el código de barras con la cámara">📷 Escanear</button>
      </div>
      <small id="autocompletar-msg" class="ayuda"></small>
    </div>

    <div class="campo">
      <label for="titulo">Título *</label>
      <input id="titulo" name="titulo" type="text" value={v.titulo} required />
    </div>

    <div class="fila-2">
      <div class="campo">
        <label for="autor">Autor *</label>
        <input id="autor" name="autor" type="text" value={v.autor} required />
      </div>
      <div class="campo">
        <label for="autores_extra">Coautores</label>
        <input id="autores_extra" name="autores_extra" type="text" value={v.autores_extra} placeholder="separados por comas" />
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Clasificación</legend>

    <div class="fila-2">
      <div class="campo">
        <label for="categoria-select">Categoría <small class="ayuda">(opcional)</small></label>
        <select id="categoria-select">
          <option value="" selected={v.categoria === ''}>Sin categoría</option>
          {categorias.map((c) => (
            <option value={c} selected={!categoriaPersonalizada && c === v.categoria}>{c}</option>
          ))}
          <option value="__otra__" selected={categoriaPersonalizada}>✏️ Otra categoría…</option>
        </select>
        <input
          id="categoria-otra"
          type="text"
          value={categoriaPersonalizada ? v.categoria : ''}
          placeholder="Escribe una categoría nueva"
          style={`margin-top:.5rem${categoriaPersonalizada ? '' : ';display:none'}`}
        />
        <input type="hidden" id="categoria" name="categoria" value={v.categoria} />
      </div>
      <div class="campo">
        <label for="subcategorias">Subcategorías / géneros</label>
        <input id="subcategorias" name="subcategorias" type="text" value={v.subcategorias} placeholder="separadas por comas" />
      </div>
    </div>

    <div class="campo">
      <label for="etiquetas">Etiquetas</label>
      <input id="etiquetas" name="etiquetas" type="text" value={v.etiquetas} placeholder="separadas por comas" />
    </div>
  </fieldset>

  <fieldset>
    <legend>Datos bibliográficos</legend>

    <div class="fila-3">
      <div class="campo">
        <label for="anio">Año</label>
        <input id="anio" name="anio" type="number" value={v.anio} min="0" max="2100" />
      </div>
      <div class="campo">
        <label for="paginas">Páginas</label>
        <input id="paginas" name="paginas" type="number" value={v.paginas} min="0" />
      </div>
      <div class="campo">
        <label for="idioma">Idioma</label>
        <select id="idioma" name="idioma">
          {IDIOMAS.map((i) => <option value={i} selected={i === v.idioma}>{i}</option>)}
        </select>
      </div>
    </div>

    <div class="campo">
      <label for="editorial">Editorial</label>
      <input id="editorial" name="editorial" type="text" value={v.editorial} />
    </div>
  </fieldset>

  <fieldset>
    <legend>En tu biblioteca</legend>

    <div class="fila-3">
      <div class="campo">
        <label for="estado">Estado de lectura</label>
        <select id="estado" name="estado">
          {ESTADOS.map((e) => <option value={e} selected={e === v.estado}>{e}</option>)}
        </select>
      </div>
      <div class="campo">
        <label for="formato">Formato</label>
        <select id="formato" name="formato">
          {FORMATOS.map((f) => <option value={f} selected={f === v.formato}>{f}</option>)}
        </select>
      </div>
      <div class="campo">
        <label for="valoracion">Valoración</label>
        <select id="valoracion" name="valoracion">
          <option value="" selected={v.valoracion === ''}>Sin valorar</option>
          {[1, 2, 3, 4, 5].map((n) => (
            <option value={n} selected={String(v.valoracion) === String(n)}>{'★'.repeat(n)}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="campo">
      <label for="ubicacion">Ubicación física</label>
      <input id="ubicacion" name="ubicacion" type="text" value={v.ubicacion} placeholder="p. ej. Salón — estantería A" />
    </div>

    <label class="check">
      <input type="checkbox" name="destacado" checked={v.destacado} />
      Destacar en el catálogo
    </label>
  </fieldset>

  <fieldset>
    <legend>Presentación</legend>

    <div class="campo">
      <label>Portada</label>
      <div class="portada-editor">
        <div class="portada-preview">
          <img id="portada-img" src={v.portada} alt="Vista previa de la portada" style={v.portada ? '' : 'display:none'} />
          <span id="portada-placeholder" class="portada-placeholder" style={v.portada ? 'display:none' : ''}>Sin portada</span>
        </div>
        <div class="portada-controles">
          <div class="portada-botones">
            <input type="file" id="portada-file" accept="image/*" hidden />
            <label for="portada-file" class="btn-secundario portada-btn">Subir imagen…</label>
            <input type="file" id="ocr-file" accept="image/*" capture="environment" hidden />
            <label for="ocr-file" class="btn-secundario portada-btn">🔤 Identificar por foto</label>
          </div>
          <small class="ayuda">Sube una foto (JPG/PNG/WebP, máx. 5 MB), pega una URL, o usa "Buscar datos" por ISBN. Con "Identificar por foto" haz una foto de la portada y se lee el título en tu dispositivo (gratis).</small>
          <input id="portada" name="portada" type="text" value={v.portada} placeholder="https://… (URL de la portada)" />
          <small id="portada-msg" class="ayuda"></small>
        </div>
      </div>
    </div>
    <div class="campo">
      <label for="sinopsis">Sinopsis</label>
      <textarea id="sinopsis" name="sinopsis" rows="3">{v.sinopsis}</textarea>
    </div>
    <div class="campo">
      <label for="notas">Notas / reseña <small class="ayuda">(admite Markdown)</small></label>
      <textarea id="notas" name="notas" rows="6">{v.notas}</textarea>
    </div>
  </fieldset>

  <fieldset>
    <legend>Venta <small class="ayuda">(opcional, para el futuro)</small></legend>

    <label class="check">
      <input type="checkbox" name="en_venta" checked={v.en_venta} />
      Disponible para la venta
    </label>

    <div class="fila-3">
      <div class="campo">
        <label for="precio">Precio (€)</label>
        <input id="precio" name="precio" type="number" value={v.precio} min="0" step="0.01" />
      </div>
      <div class="campo">
        <label for="estado_conservacion">Estado de conservación</label>
        <select id="estado_conservacion" name="estado_conservacion">
          <option value="" selected={v.estado_conservacion === ''}>—</option>
          {ESTADOS_CONSERVACION.map((e) => (
            <option value={e} selected={e === v.estado_conservacion}>{e}</option>
          ))}
        </select>
      </div>
    </div>
    <div class="campo">
      <label for="resena">Reseña destacada</label>
      <textarea id="resena" name="resena" rows="2">{v.resena}</textarea>
    </div>
  </fieldset>

  <div class="form-acciones">
    <button type="submit" class="btn">{libro ? 'Guardar cambios' : 'Añadir libro'}</button>
    <a href="/admin" class="btn-secundario">Cancelar</a>
  </div>
</form>

<div id="escaner-modal" class="escaner-modal" hidden>
  <div class="escaner-caja">
    <p class="escaner-titulo">Apunta al código de barras del libro</p>
    <video id="escaner-video" class="escaner-video" autoplay muted playsinline></video>
    <p id="escaner-msg" class="ayuda"></p>
    <button type="button" id="escaner-cerrar" class="btn-secundario">Cancelar</button>
  </div>
</div>

<script>
  import { validarIsbn } from '../lib/isbn';

  const $ = (id: string) => document.getElementById(id);

  // ── Portada: previsualización + subida ─────────────────────────────────────
  const portadaInput = $('portada') as HTMLInputElement | null;
  const portadaImg = $('portada-img') as HTMLImageElement | null;
  const portadaPlaceholder = $('portada-placeholder');
  const fileInput = $('portada-file') as HTMLInputElement | null;
  const portadaMsg = $('portada-msg');

  function actualizarPreview(url: string) {
    if (!portadaImg || !portadaPlaceholder) return;
    if (url) {
      portadaImg.src = url;
      portadaImg.style.display = '';
      portadaPlaceholder.style.display = 'none';
    } else {
      portadaImg.removeAttribute('src');
      portadaImg.style.display = 'none';
      portadaPlaceholder.style.display = '';
    }
  }

  // Reduce y normaliza cualquier imagen (JPEG, PNG, HEIC… lo que el navegador
  // sepa decodificar) a un JPEG de máx. 1600 px. Así una foto grande entra en el
  // límite de 5 MB y el OCR va más rápido. Si algo falla, devuelve el original.
  async function prepararImagen(file: File): Promise<File> {
    try {
      const bitmap = await createImageBitmap(file);
      const max = 1600;
      const escala = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
      const w = Math.round(bitmap.width * escala);
      const h = Math.round(bitmap.height * escala);
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      if (!ctx) return file;
      ctx.drawImage(bitmap, 0, 0, w, h);
      bitmap.close?.();
      const blob: Blob | null = await new Promise((r) => canvas.toBlob(r, 'image/jpeg', 0.85));
      if (!blob) return file;
      return new File([blob], 'portada.jpg', { type: 'image/jpeg' });
    } catch {
      return file;
    }
  }

  // Carga un script externo una sola vez (devuelve cuando está listo).
  function cargarScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[data-src="${src}"]`)) return resolve();
      const s = document.createElement('script');
      s.src = src;
      s.dataset.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('No se pudo cargar el lector de texto.'));
      document.head.appendChild(s);
    });
  }

  // Si la imagen pegada/subida no carga, avisar y mostrar el placeholder.
  portadaImg?.addEventListener('error', () => {
    if (portadaImg.getAttribute('src')) {
      if (portadaMsg) portadaMsg.textContent = 'No se pudo cargar esa imagen. Revisa la URL.';
      portadaImg.style.display = 'none';
      if (portadaPlaceholder) portadaPlaceholder.style.display = '';
    }
  });

  portadaInput?.addEventListener('input', () => {
    if (portadaMsg) portadaMsg.textContent = '';
    actualizarPreview(portadaInput.value.trim());
  });

  fileInput?.addEventListener('change', async () => {
    const original = fileInput.files?.[0];
    if (!original) return;
    if (portadaMsg) portadaMsg.textContent = 'Procesando imagen…';
    const file = await prepararImagen(original);
    if (file.size > 5 * 1024 * 1024) {
      if (portadaMsg) portadaMsg.textContent = 'La imagen es demasiado grande (máx. 5 MB).';
      fileInput.value = '';
      return;
    }
    if (portadaMsg) portadaMsg.textContent = 'Subiendo imagen…';
    const fd = new FormData();
    fd.append('imagen', file);
    try {
      const res = await fetch('/admin/subir-portada', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok || !data.url) {
        if (portadaMsg) portadaMsg.textContent = data.error ?? 'No se pudo subir la imagen.';
        return;
      }
      if (portadaInput) portadaInput.value = data.url;
      actualizarPreview(data.url);
      if (portadaMsg) portadaMsg.textContent = 'Imagen subida ✓';
    } catch {
      if (portadaMsg) portadaMsg.textContent = 'Error al subir la imagen.';
    } finally {
      fileInput.value = '';
    }
  });

  // ── Autocompletado por ISBN o título contra /api/autocompletar ─────────────
  const btn = $('btn-autocompletar') as HTMLButtonElement | null;
  const isbnInput = $('isbn') as HTMLInputElement | null;
  const msg = $('autocompletar-msg');

  const AVISO_ISBN = '⚠️ Ese ISBN no parece válido — revisa los dígitos.';

  // Avisa si lo escrito tiene forma de ISBN (10/13 cifras) pero su dígito de
  // control no cuadra (casi siempre, un número mal tecleado o mal escaneado).
  function revisarIsbn() {
    if (!msg || !isbnInput) return;
    if (validarIsbn(isbnInput.value.trim()) === 'invalido') {
      msg.textContent = AVISO_ISBN;
      msg.classList.add('alerta');
    } else if (msg.classList.contains('alerta')) {
      msg.textContent = ''; // ya no es inválido: quitamos la alerta
      msg.classList.remove('alerta');
    }
  }
  isbnInput?.addEventListener('input', revisarIsbn);
  isbnInput?.addEventListener('blur', revisarIsbn);

  function set(id: string, valor: unknown) {
    if (valor == null || valor === '') return;
    const el = $(id) as HTMLInputElement | HTMLTextAreaElement | null;
    if (el && !el.value) el.value = String(valor);
  }

  // Rellena el formulario desde un resultado (autocompletar o IA).
  function aplicarResultado(data: any) {
    set('titulo', data.titulo);
    set('autor', data.autor);
    set('autores_extra', (data.autores_extra ?? []).join(', '));
    set('anio', data.anio);
    set('editorial', data.editorial);
    set('paginas', data.paginas);
    set('portada', data.portada);
    set('sinopsis', data.sinopsis);
    if (data.isbn && isbnInput && !isbnInput.value) isbnInput.value = data.isbn;
    if (portadaInput) actualizarPreview(portadaInput.value.trim());
  }

  async function autocompletar() {
    const consulta = isbnInput?.value.trim();
    if (!consulta) {
      if (msg) msg.textContent = 'Escribe un ISBN o un título primero.';
      return;
    }
    // ISBN con dígito de control incorrecto: avisamos y no buscamos (está mal).
    if (validarIsbn(consulta) === 'invalido') {
      revisarIsbn();
      return;
    }
    if (btn) btn.disabled = true;
    if (msg) { msg.textContent = 'Buscando…'; msg.classList.remove('alerta'); }
    try {
      const res = await fetch(`/api/autocompletar?q=${encodeURIComponent(consulta)}`);
      const data = await res.json();
      if (!res.ok || !data.encontrado) {
        if (msg) {
          if (data.isbnInvalido) {
            msg.textContent = AVISO_ISBN;
            msg.classList.add('alerta');
          } else {
            msg.textContent = 'No se encontraron datos. Rellénalo a mano.';
          }
        }
        return;
      }
      aplicarResultado(data);
      if (msg) { msg.textContent = `Datos de ${data.fuente}. Revisa y completa lo que falte.`; msg.classList.remove('alerta'); }
    } catch {
      if (msg) msg.textContent = 'Error al buscar. Inténtalo de nuevo.';
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  btn?.addEventListener('click', autocompletar);

  // ── Escáner de código de barras (cámara, ZXing) ────────────────────────────
  const btnEscanear = $('btn-escanear') as HTMLButtonElement | null;
  const modal = $('escaner-modal');
  const video = $('escaner-video') as HTMLVideoElement | null;
  const escMsg = $('escaner-msg');
  let escControls: { stop: () => void } | null = null;
  let escStream: MediaStream | null = null;

  function cerrarEscaner() {
    if (escControls) {
      try { escControls.stop(); } catch { /* noop */ }
      escControls = null;
    }
    if (escStream) {
      escStream.getTracks().forEach((t) => t.stop());
      escStream = null;
    }
    if (video) video.srcObject = null;
    if (modal) modal.hidden = true;
  }

  $('escaner-cerrar')?.addEventListener('click', cerrarEscaner);

  btnEscanear?.addEventListener('click', async () => {
    if (!modal || !video) return;
    modal.hidden = false;
    if (escMsg) escMsg.textContent = 'Iniciando cámara…';
    try {
      // Preferir cámara trasera (móvil) y la mayor resolución posible (para leer
      // mejor códigos pequeños). Si no existe (portátil), usar cualquiera.
      const restriccion = {
        facingMode: { ideal: 'environment' },
        width: { ideal: 1920 },
        height: { ideal: 1080 },
      };
      try {
        escStream = await navigator.mediaDevices.getUserMedia({ video: restriccion });
      } catch {
        escStream = await navigator.mediaDevices.getUserMedia({ video: true });
      }
      video.srcObject = escStream;
      await video.play().catch(() => { /* algunos navegadores reproducen solos */ });

      const [{ BrowserMultiFormatReader }, { DecodeHintType, BarcodeFormat }] = await Promise.all([
        import('@zxing/browser'),
        import('@zxing/library'),
      ]);
      // Centrarse en los formatos de libros/productos y esforzarse más por frame.
      const hints = new Map();
      hints.set(DecodeHintType.POSSIBLE_FORMATS, [
        BarcodeFormat.EAN_13,
        BarcodeFormat.EAN_8,
        BarcodeFormat.UPC_A,
        BarcodeFormat.UPC_E,
      ]);
      hints.set(DecodeHintType.TRY_HARDER, true);
      const reader = new BrowserMultiFormatReader(hints);

      escControls = await reader.decodeFromStream(escStream, video, (result, _err, controls) => {
        if (!result) return;
        controls.stop();
        const code = result.getText();
        cerrarEscaner();
        if (isbnInput) isbnInput.value = code;
        autocompletar();
      });
      if (escMsg) escMsg.textContent = 'Acerca el código de barras, con buena luz, hasta que enfoque.';
    } catch {
      if (escMsg) escMsg.textContent = 'No se pudo abrir la cámara. Da permiso (icono de cámara en la barra) o escribe el ISBN a mano.';
    }
  });

  // ── Identificar por foto (OCR local con Tesseract.js) ──────────────────────
  const ocrFile = $('ocr-file') as HTMLInputElement | null;

  async function subirComoPortada(file: File) {
    const fd = new FormData();
    fd.append('imagen', file);
    try {
      const res = await fetch('/admin/subir-portada', { method: 'POST', body: fd });
      const d = await res.json();
      if (res.ok && d.url && portadaInput) {
        portadaInput.value = d.url;
        actualizarPreview(d.url);
      }
    } catch { /* la portada es opcional */ }
  }

  async function buscarPorTexto(q: string): Promise<any | null> {
    try {
      const res = await fetch(`/api/autocompletar?q=${encodeURIComponent(q)}`);
      const data = await res.json();
      return res.ok && data.encontrado ? data : null;
    } catch {
      return null;
    }
  }

  ocrFile?.addEventListener('change', async () => {
    const original = ocrFile.files?.[0];
    if (!original) return;
    if (portadaMsg) portadaMsg.textContent = 'Procesando la foto…';
    const file = await prepararImagen(original);

    // 1) LO FIABLE: usar tu foto como portada (aparece enseguida, sin depender del OCR).
    if (portadaMsg) portadaMsg.textContent = 'Guardando tu foto como portada…';
    await subirComoPortada(file);

    // 2) EXTRA (mejor esfuerzo): leer el título con OCR para autocompletar los datos.
    try {
      if (portadaMsg) portadaMsg.textContent = 'Portada lista. Cargando el lector de texto…';
      // Tesseract se carga ENTERO desde CDN (empaquetarlo con Astro rompía el worker).
      await cargarScript('https://cdn.jsdelivr.net/npm/tesseract.js@7/dist/tesseract.min.js');
      const T = (window as any).Tesseract;
      if (!T) throw new Error('Tesseract no disponible');
      const { data } = await T.recognize(file, 'spa+eng', {
        logger: (m: any) => {
          if (m.status === 'recognizing text' && portadaMsg) {
            portadaMsg.textContent = `Leyendo el título… ${Math.round((m.progress ?? 0) * 100)}%`;
          }
        },
      });

      // Líneas legibles, de la más larga a la más corta (la más larga suele ser el título).
      const lineas = (data.text || '')
        .split('\n')
        .map((s) => s.trim())
        .filter((s) => s.replace(/[^\p{L}]/gu, '').length >= 4)
        .sort((a, b) => b.length - a.length);

      if (lineas.length === 0) {
        if (portadaMsg) portadaMsg.textContent = 'Portada guardada. No leí texto claro; escribe el título o el ISBN y pulsa "Buscar datos".';
        return;
      }

      const intentos = [lineas[0], lineas[1] ? `${lineas[0]} ${lineas[1]}` : '', lineas[1] ?? '']
        .filter((q, i, a) => q !== '' && a.indexOf(q) === i);

      if (portadaMsg) portadaMsg.textContent = 'Buscando el libro…';
      let encontrado: any = null;
      for (const q of intentos) {
        encontrado = await buscarPorTexto(q);
        if (encontrado) break;
      }

      if (encontrado) {
        aplicarResultado(encontrado);
        if (portadaMsg) portadaMsg.textContent = `Datos de ${encontrado.fuente} (leídos de la foto). Revísalos.`;
      } else {
        const tituloEl = $('titulo') as HTMLInputElement | null;
        if (tituloEl && !tituloEl.value) tituloEl.value = lineas[0];
        if (portadaMsg) portadaMsg.textContent = 'Portada guardada y título leído. No lo encontré en las bases de datos; revísalo o usa el ISBN.';
      }
    } catch {
      if (portadaMsg) portadaMsg.textContent = 'Portada guardada. No pude leer el título automáticamente; escríbelo o usa el ISBN y "Buscar datos".';
    } finally {
      ocrFile.value = '';
    }
  });

  // ── Categoría: desplegable real + opción "Otra…" para escribir una nueva ───
  // El <select> siempre se abre y muestra todas las categorías (a diferencia del
  // datalist anterior, que se "cerraba" cuando el campo ya tenía un valor). El
  // valor que se envía vive en el input oculto #categoria.
  const catSelect = $('categoria-select') as HTMLSelectElement | null;
  const catOtra = $('categoria-otra') as HTMLInputElement | null;
  const catHidden = $('categoria') as HTMLInputElement | null;

  function sincronizarCategoria() {
    if (!catSelect || !catOtra || !catHidden) return;
    if (catSelect.value === '__otra__') {
      catOtra.style.display = '';
      catHidden.value = catOtra.value.trim();
    } else {
      catOtra.style.display = 'none';
      catHidden.value = catSelect.value;
    }
  }

  catSelect?.addEventListener('change', () => {
    const abrirTexto = catSelect.value === '__otra__';
    sincronizarCategoria();
    if (abrirTexto) catOtra?.focus();
  });
  catOtra?.addEventListener('input', () => {
    if (catHidden) catHidden.value = catOtra.value.trim();
  });
</script>
